---
import { cv } from "../data/cv";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header" data-print-hidden>
  <a class="brand-mark" href="#top" aria-label={`${cv.name}, home`}>
    <img class="brand-mark-light" src="/favicon-light.png" alt="" width="1254" height="1254" />
    <img class="brand-mark-dark" src="/favicon-dark.png" alt="" width="1254" height="1254" />
  </a>
  <div class="header-tools">
    <nav aria-label="Primary navigation">
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#education">Education</a>
      <a href="#projects">Projects</a>
      <a href="#skills">Skills</a>
    </nav>
    <ThemeToggle />
  </div>
</header>
