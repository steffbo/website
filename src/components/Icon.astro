---
interface Props {
  name: "arrow" | "download" | "email" | "external" | "github" | "linkedin" | "location" | "phone" | "stackoverflow";
}

const { name } = Astro.props;
---

{
  name === "arrow" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
}
{
  name === "download" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" /></svg>
}
{
  name === "email" && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
}
{
  name === "location" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
}
{
  name === "phone" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.64a2 2 0 0 1-.45 2.11L8.01 9.74a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.86.29 1.74.5 2.64.62A2 2 0 0 1 22 16.92Z" /></svg>
}
{
  name === "external" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7M10 14 21 3M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" /></svg>
}
{
  name === "github" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-3.87a3.37 3.37 0 0 0-.94-2.62c3.07-.34 6.3-1.51 6.3-6.85A5.35 5.35 0 0 0 19 4.93 4.97 4.97 0 0 0 18.87 1S17.73.66 15 2.47a13.4 13.4 0 0 0-6 0C6.27.66 5.13 1 5.13 1A4.97 4.97 0 0 0 5 4.93a5.35 5.35 0 0 0-1.36 3.73c0 5.33 3.23 6.5 6.3 6.85A3.37 3.37 0 0 0 9 18.13V22" /><path d="M9 19c-3 .92-3-1.5-4.2-1.87" /></svg>
}
{
  name === "linkedin" && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M8 11v5m0-8v.01M12 16v-5m0 2a3 3 0 0 1 6 0v3" /></svg>
}
{
  name === "stackoverflow" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 17 8 1m-7-5 7 2m-5-6 5 3m-2-6 3 4M6 20h11v-4M8 4l1 12" /></svg>
}

<style>
  svg { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.75; }
</style>
