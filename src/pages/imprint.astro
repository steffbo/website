import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Imprint &amp; privacy - Stefan Remer</title>
  </head>
  <body class="legal-page">
    <main>
      <a class="back-link" href="/">← Back to portfolio</a>
      <h1>Imprint</h1>
      <p>Stefan Remer<br />Lechtaler Straße 7<br />16341 Panketal<br />Email: <ContactReveal kind="email" /></p>
      <hr />
      <h2>Privacy policy</h2>
      <p>The web server uses default access logs that include IP addresses. They are stored for 14 days and used only to defend against cyberattacks.</p>
      <p>No personal information is collected. No tracking or third-party tools are used.</p>
    </main>
  </body>
</html>
